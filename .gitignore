# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.pth

# Model weights (large — download via HuggingFace or trained locally)
models/pretrained/
models/finetuned/

# LeanDojo trace cache (auto-rebuilt, lives in ~/.cache/lean_dojo)
.leandojo_cache/
*.ast.json
*.dep_paths
*.trace.xml

# Lean build artefacts (auto-built by `lake build`)
lean_project/.lake/
lean_project/results/

# Jupyter checkpoints
.ipynb_checkpoints/

# macOS
.DS_Store

# Temp / debug
/tmp/
*.log
lean4repl_debug.txt

# SGE job log files
*.e[0-9]*
*.o[0-9]*
*.pe[0-9]*
*.po[0-9]*

# Python venv
venv/

# Results checkpoints (large JSON — gitignored, use RESULTS.md for summary)
results/

# Secrets — never commit tokens
.env
*.token
